<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>CricketClubMiddle</RootNamespace>
    <AssemblyName>CricketClubMiddle</AssemblyName>
    <Platforms>AnyCPU;x86</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CricketClubDAL\CricketClubDAL\CricketClubDAL.csproj" />
    <ProjectReference Include="..\CricketClubDomain\CricketClubDomain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Logging\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude Web Forms specific files that don't work in .NET 8 -->
    <Compile Remove="Web\**" />
  </ItemGroup>

</Project>